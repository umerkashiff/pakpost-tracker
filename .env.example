# Required: Upstash Redis / Vercel KV credentials for encrypted state & diff hashes
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# Required: Owner passcode to unlock daily list mutations & Settings (can also be changed in UI)
SETTINGS_PASSCODE=choose_a_strong_passcode

# Secret used to encrypt Redis entries (falls back to CRON_SECRET if omitted)
ENCRYPTION_KEY=random_32_byte_secret

# Optional: Protects /api/cron via Bearer token or ?secret= and salts HMAC aliases
CRON_SECRET=your_cron_secret

# Optional: Upstash QStash credentials to make schedule changes in Settings apply live without redeploy
QSTASH_TOKEN=
QSTASH_URL=

# Optional: Default webhook URL (Discord, Slack, or generic JSON webhook)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN

# Optional: Numeric Discord user ID to ping when sending Discord embeds
DISCORD_PING_USER_ID=

# Optional: Fallback seed list when Redis is empty (ID:Label,ID2:Label2)
TRACKING_IDS=CP123456789PK:Sample Parcel
